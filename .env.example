# مفتاح Gemini API (اختياري) — كل مستخدم يدخل مفتاحه الخاص من داخل التطبيق ويُحفظ في متصفحه فقط.
# إن تم ضبطه هنا، يعمل كخيار احتياطي على الخادم فقط عندما لا يرسل المتصفح ترويسة x-api-key.
# احصل على مفتاح مجاني من Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# المنفذ الذي يستمع عليه الخادم (Render يضبطه تلقائياً، افتراضياً 3000 محلياً)
PORT=3000

# بيئة التشغيل: development محلياً، و production على Render
NODE_ENV=development

# النطاقات المسموح لها بالوصول عبر CORS (اختياري — اتركه فارغاً للنشر كخدمة واحدة على نفس النطاق)
# مثال عند الحاجة لعدة نطاقات: https://aboodi-ai.onrender.com,https://chat.example.com
ALLOWED_ORIGINS=""

# حماية ضد إساءة الاستخدام (Rate Limiting) لمسار المحادثة /api/chat
# العدد الأقصى للطلبات لكل عنوان IP خلال النافذة الزمنية (بالملي ثانية)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# رابط التطبيق (اختياري — يُحقن تلقائياً في بيئة AI Studio)
APP_URL="MY_APP_URL"
